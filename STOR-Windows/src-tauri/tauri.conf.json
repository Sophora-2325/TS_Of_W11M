{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "STOR",
  "version": "0.1.0",
  "identifier": "com.wtp.stor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run ocr:check && npm run engine:check && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "STOR 设置",
        "width": 800,
        "height": 820,
        "minWidth": 320,
        "minHeight": 320,
        "visible": false,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/ocr/": "ocr/",
      "resources/llama.cpp/": "llama.cpp/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
